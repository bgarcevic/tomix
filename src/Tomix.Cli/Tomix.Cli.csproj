<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tomix.App\Tomix.App.csproj" />
    <ProjectReference Include="..\Tomix.Auth\Tomix.Auth.csproj" />
    <ProjectReference Include="..\Tomix.Core\Tomix.Core.csproj" />
    <ProjectReference Include="..\Tomix.Provider.Tom\Tomix.Provider.Tom.csproj" />
    <ProjectReference Include="..\Tomix.Provider.Vpax\Tomix.Provider.Vpax.csproj" />
    <ProjectReference Include="..\Tomix.Provider.Tmdl\Tomix.Provider.Tmdl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tomix.Cli.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tx</ToolCommandName>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Tomix.Cli</PackageId>
    <Authors>Boris Garcevic</Authors>
    <Description>tx - open-source CLI for inspecting, validating, querying, testing, and deploying tabular semantic models (Power BI, Microsoft Fabric, Analysis Services).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bgarcevic/tomix-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bgarcevic/tomix-cli</RepositoryUrl>
    <PackageTags>powerbi;fabric;analysis-services;tabular;tmdl;semantic-model;dax;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Keeps two transitive native libraries out of every published build (release archives,
    the dotnet tool package, Native AOT):
    - msalruntime (MSAL broker/WAM) only serves ADOMD's own sign-in. tx never lets ADOMD sign
      in: every remote connection gets a token from tx's own MSAL client or fails first.
    - msasxpress (ADOMD XPress compression) is optional. ADOMD looks for it only next to its own
      assembly file, so single-file and AOT builds never found it anyway; without it, ADOMD
      talks to the server uncompressed.
    Native AOT cannot embed native libraries, so this is also what makes the AOT build a single
    file.
  -->
  <Target Name="ExcludeUnusedNativeLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Filename)').Contains('msalruntime')) Or '%(Filename)' == 'msasxpress'" />
    </ItemGroup>
  </Target>

</Project>
