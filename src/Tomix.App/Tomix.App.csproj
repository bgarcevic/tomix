<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Tomix.Core\Tomix.Core.csproj" />
    <ProjectReference Include="..\Tomix.Platform\Tomix.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure .NET JavaScript interpreter that runs the embedded offline M engine (Format/M). -->
    <PackageReference Include="Jint" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
    <!-- Windows-only, and used only by Connect/PowerBiDesktopProcesses to read the msmdsrv
         command line. Guarded by OperatingSystem.IsWindows(); no-ops elsewhere. -->
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Bpa\Rules\bpa-rules.json" />
    <!-- Generated by engines/powerquery (npm ci && npm run build); committed so builds need no npm. -->
    <EmbeddedResource Include="Format\M\powerquery-engine.js" LogicalName="Tomix.App.Format.M.powerquery-engine.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tomix.App.Tests" />
  </ItemGroup>

</Project>
